{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2020"],
		"strict": true,
		"noImplicitAny": true,
		"importHelpers": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
